{
  "version": 6,
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "clang-debug",
      "inherits": "clang-base",
      "displayName": "Clang Debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "clang-release",
      "inherits": "clang-base",
      "displayName": "Clang Release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "IMLUI_DEV_PATHS_RELEASE_OK": "ON" }
    },
    {
      "name": "clang-ship",
      "inherits": "clang-base",
      "displayName": "Clang Release, shipped: everything embedded, no source paths",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "IMLUI_DEV_PATHS": "OFF" }
    },
    {
      "name": "clang-asan",
      "inherits": "clang-base",
      "displayName": "Clang Debug + AddressSanitizer + UBSan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL",
        "IMLUI_SANITIZERS": "address,undefined"
      }
    },
    {
      "name": "clang-fuzz",
      "inherits": "clang-base",
      "displayName": "Clang RelWithDebInfo + libFuzzer + AddressSanitizer + UBSan (tests/fuzz)",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded",
        "IMLUI_SANITIZERS": "address,undefined",
        "IMLUI_FUZZ": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "clang-debug", "configurePreset": "clang-debug" },
    { "name": "clang-release", "configurePreset": "clang-release" },
    { "name": "clang-ship", "configurePreset": "clang-ship" },
    { "name": "clang-asan", "configurePreset": "clang-asan" },
    { "name": "clang-fuzz", "configurePreset": "clang-fuzz" }
  ],
  "testPresets": [
    { "name": "clang-debug", "configurePreset": "clang-debug", "output": { "outputOnFailure": true } },
    { "name": "clang-ship", "configurePreset": "clang-ship", "output": { "outputOnFailure": true } },
    { "name": "clang-asan", "configurePreset": "clang-asan", "output": { "outputOnFailure": true } },
    { "name": "clang-fuzz", "configurePreset": "clang-fuzz", "output": { "outputOnFailure": true } }
  ]
}
