# Lua language-server definitions as a build step: runs an app host with `--lua-defs <dir>`, which makes
# Engine::run() write the LuaLS `---@meta` files of the DSL and of every type and singleton the host registered
# (imlui.lua, types.lua) into <dir> and exit, without opening a window. See docs/extending.md, "Editor support: Lua
# definitions". imlui's CMakeLists.txt includes this file, and so does the installed package's imluiConfig.cmake.
#
#   imlui_add_lua_definitions(<target> [OUTPUT <dir>] [ALL] [LUARC <dir> [IGNORE <dir>...]])
#
#     Adds the target <target>_lua_definitions, which runs <target> (an executable whose main() registers its types
#     and calls Engine::run() with defaultConfig(argc, argv, ...)) with `--lua-defs <dir>` after <target> was built.
#     OUTPUT defaults to <current binary dir>/lua-definitions; a relative one is relative to the current binary dir.
#     ALL builds it with `all`, so the definitions follow every change of the registered types; otherwise build it
#     when you want them (`cmake --build <build> --target <target>_lua_definitions`). The files are rewritten only
#     when their content changes. The host runs on the build machine, so this doesn't work when cross-compiling.
#
#     LUARC <dir> also writes <dir>/.luarc.json at configure time (usually LUARC ${PROJECT_SOURCE_DIR}: the folder
#     the editor opens), so the language server finds the definitions with no setup: Lua 5.4, the OUTPUT folder as a
#     library, and these folders ignored: the build tree, a copy of imlui inside <dir> (a submodule: its own scripts
#     would define the DSL a second time), and every IGNORE folder (relative to <dir>). The file's first line marks it
#     as generated; it is rewritten at every configure (the last configured build tree wins) as long as that line is
#     there. Delete the line to keep your own edits: a .luarc.json without it is never touched (a warning says so).
include_guard(GLOBAL)

# A JSON string of `path` for <dir>/.luarc.json: relative to <dir> when inside it, else absolute; forward slashes.
function(_imlui_luarc_path dir path out)
    cmake_path(IS_PREFIX dir ${path} NORMALIZE inside)
    if(inside)
        cmake_path(RELATIVE_PATH path BASE_DIRECTORY ${dir} OUTPUT_VARIABLE path)
    endif()
    if(path STREQUAL "" OR path STREQUAL ".")
        set(path ".")
    endif()
    string(REGEX REPLACE "/$" "" path "${path}")
    set(${out} "\"${path}\"" PARENT_SCOPE)
endfunction()

function(_imlui_write_luarc dir output ignores)
    if(NOT IS_ABSOLUTE ${dir})
        set(dir ${CMAKE_CURRENT_SOURCE_DIR}/${dir})
    endif()
    cmake_path(NORMAL_PATH dir)
    set(file ${dir}/.luarc.json)
    # Computed here, not when this file is included: a function sees its caller's variables, not those of the
    # directory that included it. imlui's root: this file is in <root>/cmake/ (<prefix>/lib/cmake/imlui/ installed).
    set(marker_text "// Generated by imlui_add_lua_definitions (CMake)")
    set(imlui_root ${CMAKE_CURRENT_FUNCTION_LIST_DIR}/..)
    cmake_path(NORMAL_PATH imlui_root)

    _imlui_luarc_path(${dir} ${output} library)
    set(ignored "")
    # The build tree and a copy of imlui, when they are inside <dir>, then the IGNORE folders.
    foreach(candidate ${CMAKE_BINARY_DIR} ${imlui_root})
        cmake_path(IS_PREFIX dir ${candidate} NORMALIZE inside)
        if(inside AND NOT candidate STREQUAL dir)
            _imlui_luarc_path(${dir} ${candidate} entry)
            list(APPEND ignored ${entry})
        endif()
    endforeach()
    foreach(entry ${ignores})
        if(NOT IS_ABSOLUTE ${entry})
            set(entry ${dir}/${entry})
        endif()
        cmake_path(NORMAL_PATH entry)
        _imlui_luarc_path(${dir} ${entry} entry)
        list(APPEND ignored ${entry})
    endforeach()
    list(REMOVE_DUPLICATES ignored)
    list(JOIN ignored ", " ignored)

    set(content "${marker_text}: rewritten at every configure. Delete this line to keep your own edits.
{
    \"runtime.version\": \"Lua 5.4\",
    \"workspace.library\": [${library}],
    \"workspace.ignoreDir\": [${ignored}]
}
")
    if(EXISTS ${file})
        file(READ ${file} existing)
        if(existing STREQUAL content)
            return()
        endif()
        string(FIND "${existing}" "${marker_text}" marker)
        if(NOT marker EQUAL 0)
            message(WARNING "imlui_add_lua_definitions: ${file} wasn't generated (its first line isn't the "
                            "imlui marker), so it is left alone. For the definitions, add ${library} to its "
                            "\"workspace.library\".")
            return()
        endif()
    endif()
    file(WRITE ${file} "${content}")
endfunction()

function(imlui_add_lua_definitions target)
    cmake_parse_arguments(PARSE_ARGV 1 arg "ALL" "OUTPUT;LUARC" "IGNORE")
    if(arg_UNPARSED_ARGUMENTS)
        message(FATAL_ERROR "imlui_add_lua_definitions: unknown arguments ${arg_UNPARSED_ARGUMENTS}")
    endif()
    if(arg_IGNORE AND NOT arg_LUARC)
        message(FATAL_ERROR "imlui_add_lua_definitions: IGNORE needs LUARC")
    endif()
    if(NOT TARGET ${target})
        message(FATAL_ERROR "imlui_add_lua_definitions: ${target} is not a target")
    endif()
    set(output ${arg_OUTPUT})
    if(NOT output)
        set(output ${CMAKE_CURRENT_BINARY_DIR}/lua-definitions)
    elseif(NOT IS_ABSOLUTE ${output})
        set(output ${CMAKE_CURRENT_BINARY_DIR}/${output})
    endif()
    cmake_path(NORMAL_PATH output)
    set(all "")
    if(arg_ALL)
        set(all ALL)
    endif()
    add_custom_target(${target}_lua_definitions ${all}
        COMMAND $<TARGET_FILE:${target}> --lua-defs ${output}
        WORKING_DIRECTORY ${CMAKE_CURRENT_BINARY_DIR}
        COMMENT "Writing the Lua definitions of ${target} to ${output}"
        VERBATIM)
    add_dependencies(${target}_lua_definitions ${target})
    if(arg_LUARC)
        _imlui_write_luarc(${arg_LUARC} ${output} "${arg_IGNORE}")
    endif()
endfunction()
