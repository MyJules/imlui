// Engine configuration and the standard config for an app host.
module;

#include <algorithm>
#include <cstdlib>
#include <filesystem>
#include <initializer_list>
#include <memory>
#include <string>
#include <string_view>
#include <system_error>
#include <utility>
#include <vector>

export module imlui.app.config;

import imlui.log;
import imlui.platform.window;
import imlui.resources;
import imlui.resources.directory_mount;
import imlui.resources.package;
import imlui.resources.pak_mount;
import imlui.embedded.imlui;

export namespace imlui {

struct EngineConfig {
    /// Where every file comes from: `imlui:/` (src/resources/imlui.lua), `imlui:/fonts/` (Roboto, Material Icons and
    /// their codepoints) and `app:/` (the app's scripts and data). Must outlive the font atlas, which points
    /// into the font files; the Engine keeps it for its whole lifetime.
    Resources resources;
    std::string entry = "app:/main.lua"; ///< the main UI script, a full resource name
    platform::Window::Config window;
    bool hotReload = true; ///< reload when a Lua file in a mutable mount (a directory) changes
    /// When > 0, quit after this many rendered frames and exit with 1 if a script error was reported (smoke
    /// tests). defaultConfig() reads it from the environment variable IMLUI_EXIT_AFTER_FRAMES.
    int exitAfterFrames = 0;
};

/// Mounts every `*.pak` archive in `folder`, in file name order, each at the mount point stored in it. Archives
/// that can't be read (logged), or whose mount point is in prefix `skipPrefix`, are skipped. Returns how many were
/// mounted.
int mountPaks(Resources& resources, const std::filesystem::path& folder, std::string_view skipPrefix = {});

/// Standard config for an app host: `imlui::Engine engine{imlui::defaultConfig(argc, argv, my_app::packages())};`
/// `app` lists the app's embedded files: `imlui::embedded::<name>::packages()`, generated by imlui_add_resources
/// from a resource manifest, one package per group of the manifest. The library's own (`imlui:/`, `imlui:/fonts/`)
/// always come first. Mounts, from the bottom of the stack (overridden) to the top (wins):
///
///  1. the embedded files of every package;
///  2. every `*.pak` next to the executable (mountPaks());
///  3. override folders next to the executable, named after a prefix, where they exist: `<exe folder>/app/` at
///     `app:/`, `<exe folder>/imlui/` at `imlui:/`, and likewise for the prefix of every package;
///  4. dev builds (IMLUI_DEV_PATHS=ON): each package's source folder at its mount point, where it exists, so editing
///     the sources hot-reloads. The environment variable IMLUI_DEV_PATHS=0 skips them.
///
/// The entry is `app:/main.lua`. A script given as argv[1] replaces the app: nothing above is mounted at `app:/`,
/// the script's folder is mounted there instead, and the entry is `app:/<file name>`. A relative argv[1] is resolved
/// against the current folder, or the executable's folder when it doesn't exist there (so scripts shipped next to
/// the executable, `my_app scripts/tool.lua`, run from anywhere).
[[nodiscard]] EngineConfig defaultConfig(int argc, char** argv, std::vector<ResourcePackage> app = {});

/// defaultConfig() with the packages of several embedded modules, in order:
/// `defaultConfig(argc, argv, {my_app::packages(), charts::packages()})`.
[[nodiscard]] EngineConfig defaultConfig(int argc, char** argv,
                                         std::initializer_list<std::vector<ResourcePackage>> apps);

} // namespace imlui

module :private;

namespace imlui {

namespace fs = std::filesystem;

namespace {

/// `arg` relative to the current folder, or to `exeDir` when it only exists there.
fs::path resolveScript(const fs::path& arg, const fs::path& exeDir) {
    std::error_code ec;
    if (arg.is_relative() && !fs::exists(arg, ec) && fs::exists(exeDir / arg, ec)) return exeDir / arg;
    return fs::absolute(arg, ec);
}

/// The value of environment variable `name`, "" when unset.
std::string environment(const char* name) {
    // MSVC's CRT deprecates getenv in favor of _dupenv_s. It's read once at startup and nothing else changes the
    // environment, so the plain call is fine and stays portable.
#pragma clang diagnostic push
#pragma clang diagnostic ignored "-Wdeprecated-declarations"
    const char* value = std::getenv(name);
#pragma clang diagnostic pop
    return value ? std::string{value} : std::string{};
}

bool isDirectory(const fs::path& p) {
    std::error_code ec;
    return fs::is_directory(p, ec);
}

std::string utf8(const fs::path& p) {
    const std::u8string s = p.generic_u8string();
    return std::string{s.begin(), s.end()};
}

fs::path pathFromUtf8(std::string_view s) { return fs::path{std::u8string{s.begin(), s.end()}}; }

/// The prefix of mount point `point` (`app` for `app:/x/`).
std::string_view prefixOf(std::string_view point) { return point.substr(0, point.find(':')); }

} // namespace

int mountPaks(Resources& resources, const fs::path& folder, std::string_view skipPrefix) {
    std::vector<fs::path> paks;
    std::error_code ec;
    for (auto it = fs::directory_iterator(folder, ec); !ec && it != fs::directory_iterator(); it.increment(ec))
        if (it->path().extension() == ".pak" && it->is_regular_file(ec)) paks.push_back(it->path());
    std::ranges::sort(paks);
    int mounted = 0;
    for (const auto& file : paks) {
        std::string error;
        auto pak = PakMount::open(file, &error);
        if (!pak) {
            log::warn("skipping {}", error);
            continue;
        }
        const std::string point = pak->mountPoint();
        if (!skipPrefix.empty() && prefixOf(point) == skipPrefix) continue;
        if (resources.mount(point, std::move(pak))) ++mounted;
    }
    return mounted;
}

EngineConfig defaultConfig(int argc, char** argv, std::vector<ResourcePackage> app) {
    const fs::path exeDir = fs::absolute(fs::path{argv[0]}).parent_path();
    const bool scriptArg = argc > 1;
    // A script on the command line is the app: nothing else is mounted at app:/.
    const std::string_view replaced = scriptArg ? "app" : "";

    std::vector<ResourcePackage> packages = embedded::imlui::packages();
    for (ResourcePackage& p : app)
        if (prefixOf(p.mountPoint) != replaced) packages.push_back(std::move(p));
    std::vector<std::string> prefixes{"app"};
    for (const ResourcePackage& p : packages)
        if (std::ranges::find(prefixes, prefixOf(p.mountPoint)) == prefixes.end())
            prefixes.emplace_back(prefixOf(p.mountPoint));

    EngineConfig cfg;
    Resources& res = cfg.resources;
    // Bottom of the stack: what the executable carries.
    for (const ResourcePackage& p : packages)
        res.mount(p.mountPoint, p.files);
    // Archives next to the executable override embedded files.
    mountPaks(res, exeDir, replaced);
    // Loose files next to the executable override both: <exe folder>/<prefix>/ at <prefix>:/.
    for (const std::string& prefix : prefixes)
        if (prefix != replaced && isDirectory(exeDir / prefix))
            res.mount(prefix + ":/", std::make_shared<DirectoryMount>(exeDir / prefix));
    // Dev builds: the folders the files were embedded from, on top, so editing them hot-reloads.
    if (environment("IMLUI_DEV_PATHS") != "0")
        for (const ResourcePackage& p : packages)
            if (!p.sourceDir.empty() && isDirectory(pathFromUtf8(p.sourceDir)))
                res.mount(p.mountPoint, std::make_shared<DirectoryMount>(pathFromUtf8(p.sourceDir)));
    // A script named on the command line is always mounted, so a missing one is reported where it was looked for.
    if (scriptArg) {
        const fs::path script = resolveScript(fs::path{argv[1]}, exeDir);
        res.mount("app:/", std::make_shared<DirectoryMount>(script.parent_path()));
        cfg.entry = "app:/" + utf8(script.filename());
    }

    if (const std::string frames = environment("IMLUI_EXIT_AFTER_FRAMES"); !frames.empty())
        cfg.exitAfterFrames = std::max(0, std::atoi(frames.c_str()));
    return cfg;
}

EngineConfig defaultConfig(int argc, char** argv, std::initializer_list<std::vector<ResourcePackage>> apps) {
    std::vector<ResourcePackage> all;
    for (const auto& packages : apps)
        all.insert(all.end(), packages.begin(), packages.end());
    return defaultConfig(argc, argv, std::move(all));
}

} // namespace imlui
