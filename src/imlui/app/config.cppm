// Engine configuration and the standard config for an app host. Declarations only: the definitions are in the
// implementation units config.cpp and default_config.cpp (no private module fragment, which would forbid them).
export module imlui.app.config;

import std;

import imlui.platform.window;
import imlui.resources;
import imlui.resources.package;

export namespace imlui {

struct EngineConfig {
    /// Where every file comes from: `imlui:/` (src/resources/imlui.lua), `imlui:/fonts/` (Roboto, Material Icons and
    /// their codepoints) and `app:/` (the app's scripts and data). Must outlive the font atlas, which points
    /// into the font files; the Engine keeps it for its whole lifetime.
    Resources resources;
    std::string entry = "app:/main.lua"; ///< the main UI script, a full resource name
    platform::Window::Config window;
    bool hotReload = true; ///< reload when a Lua file in a mutable mount (a directory) changes
    /// When > 0, quit after this many rendered frames and exit with 1 if a script error was reported (smoke
    /// tests). defaultConfig() reads it from the environment variable IMLUI_EXIT_AFTER_FRAMES.
    int exitAfterFrames = 0;
    /// When set, run() writes the Lua language-server definitions of the registered types into this folder
    /// (Engine::writeLuaDefinitions) and returns, without opening a window: 0 when written, 1 when not. defaultConfig()
    /// takes it from the command-line option `--lua-defs <dir>` (or `--lua-defs=<dir>`) or the environment variable
    /// IMLUI_LUA_DEFS.
    std::filesystem::path luaDefinitions;
};

/// Mounts every `*.pak` archive in `folder`, in file name order, each at the mount point stored in it. Archives
/// that can't be read or aren't valid (logged: junk, a truncated or oversized file), or whose mount point is in
/// prefix `skipPrefix`, are skipped; never throws. Returns how many were
/// mounted.
int mountPaks(Resources& resources, const std::filesystem::path& folder, std::string_view skipPrefix = {});

/// defaultConfig() with the library's own packages given: `library` and then `app`. defaultConfig() passes
/// `imlui::embedded::imlui::packages()`. It's defined (default_config.cpp, an implementation unit of this module) by
/// the target that holds that generated module, `imlui`, not by imlui_core with the rest of this module: the library's
/// files then come in two variants (src/CMakeLists.txt: the build tree's and an install's) that share one compiled
/// imlui_core, and editing them rebuilds nothing that links imlui.
[[nodiscard]] EngineConfig defaultConfigWith(int argc, char** argv, std::vector<ResourcePackage> library,
                                             std::vector<ResourcePackage> app);

/// Standard config for an app host: `imlui::Engine engine{imlui::defaultConfig(argc, argv, my_app::packages())};`
/// `app` lists the app's embedded files: `imlui::embedded::<name>::packages()`, generated by imlui_add_resources
/// from a resource manifest, one package per group of the manifest. The library's own (`imlui:/`, `imlui:/fonts/`)
/// always come first. Mounts, from the bottom of the stack (overridden) to the top (wins):
///
///  1. the embedded files of every package (none for a package built with IMLUI_EMBED_RESOURCES=OFF);
///  2. every `*.pak` next to the executable (mountPaks()). The executable's folder is where the OS says it runs from
///     when argv is the process's own command line (not argv[0], which may be a bare name found through PATH), or
///     the folder of argv[0] when the host passes a list of its own;
///  3. override folders next to the executable, named after a prefix, where they exist: `<exe folder>/app/` at
///     `app:/`, `<exe folder>/imlui/` at `imlui:/`, and likewise for the prefix of every package;
///  4. dev builds (IMLUI_DEV_PATHS=ON): each package's source folder at its mount point, where it exists, so editing
///     the sources hot-reloads. The folder serves only the files the package's manifest group selects (its
///     ResourceSelection), like the embedded copy. The environment variable IMLUI_DEV_PATHS=0 skips them, except for
///     packages without embedded files, whose folder is their only copy; when such a folder doesn't exist (the
///     executable runs on another machine), an error names it.
///
/// The entry is `app:/main.lua`. `--lua-defs <dir>` (or `--lua-defs=<dir>`) anywhere after argv[0] sets
/// EngineConfig::luaDefinitions and is taken out of the arguments; without it the environment variable
/// IMLUI_LUA_DEFS=<dir> sets it. A script given as the first other argument replaces the app: nothing above is mounted
/// at `app:/`, the script's folder is mounted there instead, and the entry is `app:/<file name>`. A relative script is
/// resolved against the current folder, or the executable's folder when it doesn't exist there (so scripts shipped
/// next to the executable, `my_app scripts/tool.lua`, run from anywhere). On Windows it's read from the UTF-16 command
/// line, so a file name outside the ANSI code page works.
///
/// Defined in default_config.cpp, not here, like the overload below: see defaultConfigWith().
[[nodiscard]] EngineConfig defaultConfig(int argc, char** argv, std::vector<ResourcePackage> app = {});

/// defaultConfig() with the packages of several embedded modules, in order:
/// `defaultConfig(argc, argv, {my_app::packages(), charts::packages()})`.
[[nodiscard]] EngineConfig defaultConfig(int argc, char** argv,
                                         std::initializer_list<std::vector<ResourcePackage>> apps);

} // namespace imlui
