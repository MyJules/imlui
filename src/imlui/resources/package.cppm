// ResourcePackage: a block of embedded files and where it belongs, as defaultConfig() mounts it.
module;

#include <memory>
#include <string>

export module imlui.resources.package;

import imlui.resources.mount;

export namespace imlui {

/// One embedded block of files, as `imlui::embedded::<name>::package()` (generated by imlui_add_resources)
/// returns it: the files, their mount point and, in dev builds, the folder they were embedded from.
struct ResourcePackage {
    std::string mountPoint;       ///< `app:/`, `imlui:/fonts/`
    std::shared_ptr<Mount> files; ///< the embedded files
    /// The absolute folder the files come from (imlui_add_resources' BASE) when the build has IMLUI_DEV_PATHS=ON,
    /// otherwise "". defaultConfig() mounts it over the embedded files, so editing them hot-reloads.
    std::string sourceDir;
};

} // namespace imlui
