// imlui_rc: the build-time tool behind imlui_add_resources (cmake/ImluiResources.cmake). It encodes the files of a
// resource spec (imlui.tools.resource_spec) and writes them as a blob plus a C++ module that embeds the blob with
// `#embed` and mounts it:
//
//     imlui_rc <spec file> <output folder>    writes <output folder>/<name>.bin and <name>.cppm
//
// The generated module is `imlui.embedded.<name>`, exporting `imlui::embedded::<name>::files()` (the
// EmbeddedMount, shared), `mount(Resources&)` (mounts it at the spec's mount point) and `package()` (a
// ResourcePackage: the files, the mount point and the spec's dev source folder, "" when it has none).
module;

#include <algorithm>
#include <cstddef>
#include <cstdint>
#include <filesystem>
#include <fstream>
#include <iostream>
#include <span>
#include <string>
#include <string_view>
#include <vector>

export module imlui.tools.rc;

import imlui.tools.resource_encoding;
import imlui.tools.resource_spec;

export namespace imlui::tools {

/// The tool's main(); returns the process exit code.
[[nodiscard]] int runRc(int argc, char** argv);

/// True when `name` can name a generated module and namespace: lowercase ASCII letters, digits and `_`, starting
/// with a letter.
[[nodiscard]] bool isResourceIdentifier(std::string_view name);

} // namespace imlui::tools

module :private;

namespace imlui::tools {

namespace fs = std::filesystem;

namespace {

/// `s` as a C++ string literal body. Octal escapes, so a following digit can't extend them.
std::string escaped(std::string_view s) {
    std::string out;
    for (const char c : s) {
        const auto u = static_cast<unsigned char>(c);
        if (c == '"' || c == '\\' || u < 0x20 || u >= 0x7f) {
            out += '\\';
            out += static_cast<char>('0' + ((u >> 6) & 7));
            out += static_cast<char>('0' + ((u >> 3) & 7));
            out += static_cast<char>('0' + (u & 7));
        } else {
            out += c;
        }
    }
    return out;
}

bool writeIfChanged(const fs::path& file, std::span<const std::byte> bytes) {
    if (auto old = readFile(file); old && std::ranges::equal(*old, bytes)) return true;
    std::ofstream out{file, std::ios::binary | std::ios::trunc};
    out.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
    return static_cast<bool>(out);
}

struct Record {
    std::string path;
    std::uint64_t offset = 0;
    std::uint64_t storedSize = 0;
    std::uint64_t size = 0;
    bool compressed = false;
};

std::string moduleSource(const ResourceSpec& spec, const std::vector<Record>& records) {
    const std::string& n = spec.name;
    std::string s;
    s += "// Generated by imlui_rc (imlui_add_resources) from " + escaped(utf8(spec.base)) + ". Do not edit.\n";
    s += "module;\n\n#include <cstddef>\n#include <memory>\n#include <span>\n#include <string>\n\n";
    s += "export module imlui.embedded." + n + ";\n\n";
    s += "import imlui.resources;\nimport imlui.resources.embedded_mount;\nimport imlui.resources.package;\n\n";
    s += "export namespace imlui::embedded::" + n + " {\n\n";
    s += "/// The embedded files (" + std::to_string(records.size()) + "), one mount shared by every caller.\n";
    s += "[[nodiscard]] std::shared_ptr<EmbeddedMount> files();\n";
    s += "/// Mounts files() at `" + escaped(spec.mountPoint) + "`.\n";
    s += "void mount(Resources& resources);\n";
    s += "/// files() with their mount point and dev source folder (";
    s += spec.sourceDir.empty() ? std::string{"none: built with IMLUI_DEV_PATHS=OFF"} : escaped(spec.sourceDir);
    s += "), for defaultConfig().\n";
    s += "[[nodiscard]] ResourcePackage package();\n\n";
    s += "} // namespace imlui::embedded::" + n + "\n\nmodule :private;\n\n";
    s += "namespace imlui::embedded::" + n + " {\n\nnamespace {\n\n";
    s += "// #embed is a C23 feature that clang offers in C++ as an extension; this generated file is the one place\n";
    s += "// that uses it.\n";
    s += "#pragma clang diagnostic push\n#pragma clang diagnostic ignored \"-Wc23-extensions\"\n";
    s += "constexpr unsigned char blob[] = {\n#embed \"" + n + ".bin\" if_empty(0)\n};\n";
    s += "#pragma clang diagnostic pop\n\n";
    if (records.empty()) {
        s += "constexpr std::span<const EmbeddedMount::Record> records{};\n\n";
    } else {
        s += "constexpr EmbeddedMount::Record records[] = {\n";
        for (const auto& r : records)
            s += "    {\"" + escaped(r.path) + "\", " + std::to_string(r.offset) + ", " + std::to_string(r.storedSize) +
                 ", " + std::to_string(r.size) + ", " + (r.compressed ? "true" : "false") + "},\n";
        s += "};\n\n";
    }
    s += "} // namespace\n\n";
    s += "std::shared_ptr<EmbeddedMount> files() {\n";
    s += "    static const auto instance = std::make_shared<EmbeddedMount>(\"" + n +
         "\", std::as_bytes(std::span{blob}), records);\n";
    s += "    return instance;\n}\n\n";
    s += "void mount(Resources& resources) { resources.mount(\"" + escaped(spec.mountPoint) + "\", files()); }\n\n";
    s += "ResourcePackage package() { return {\"" + escaped(spec.mountPoint) + "\", files(), \"" +
         escaped(spec.sourceDir) + "\"}; }\n\n";
    s += "} // namespace imlui::embedded::" + n + "\n";
    return s;
}

int fail(std::string_view message) {
    std::cerr << "imlui_rc: " << message << '\n';
    return 1;
}

} // namespace

bool isResourceIdentifier(std::string_view name) {
    if (name.empty() || name.front() < 'a' || name.front() > 'z') return false;
    for (const char c : name)
        if (!((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_')) return false;
    return true;
}

int runRc(int argc, char** argv) {
    if (argc != 3) return fail("usage: imlui_rc <spec file> <output folder>");
    std::string error;
    const auto spec = readSpec(fs::path{argv[1]}, error);
    if (!spec) return fail(error);
    if (!isResourceIdentifier(spec->name)) return fail("invalid name '" + spec->name + "'");

    std::vector<std::byte> blob;
    std::vector<Record> records;
    for (const auto& f : spec->files) {
        if (f.path.find(':') != std::string::npos || f.path.find('\\') != std::string::npos)
            return fail("'" + f.path + "': resource paths can't contain ':' or '\\'");
        const auto data = readFile(f.file);
        if (!data) return fail("can't read '" + utf8(f.file) + "'");
        const EncodedResource encoded = encodeResource(f.path, *data);
        records.push_back({f.path, blob.size(), encoded.stored.size(), encoded.size, encoded.compressed});
        blob.insert(blob.end(), encoded.stored.begin(), encoded.stored.end());
    }

    const fs::path outDir{argv[2]};
    std::error_code ec;
    fs::create_directories(outDir, ec);
    const std::string source = moduleSource(*spec, records);
    if (!writeIfChanged(outDir / (spec->name + ".bin"), blob) ||
        !writeIfChanged(outDir / (spec->name + ".cppm"), std::as_bytes(std::span{source})))
        return fail("can't write to '" + utf8(outDir) + "'");
    return 0;
}

} // namespace imlui::tools
